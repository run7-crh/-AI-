# DeepSeek API
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# Tavily Search
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# Authentication (use a unique password; never commit the real .env file)
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-this-admin-password
# AUTH_COOKIE_NAME=agent_session
# AUTH_SESSION_TTL_SECONDS=604800
# AUTH_COOKIE_SECURE=false
# AUTH_PASSWORD_MIN_LENGTH=8
# AUTH_PASSWORD_MAX_LENGTH=128
# KB_IMPORT_MAX_FILE_BYTES=10485760
# KB_IMPORT_MAX_FILES=20
# LOG_DIR=backend/data/logs

# 知识库目录（必填：放置 .md 笔记的目录，绝对或相对项目根的路径）
# 默认值：<项目根>/data/raw
# 如需自定义，取消下面注释并修改路径
# KB_DATA_DIR=./data/raw

# Chroma 持久化目录与 collection 名（可选，默认值见 config.py）
# CHROMA_PERSIST_DIR=backend/data/chroma
# CHROMA_COLLECTION_NAME=obsidian_kb
